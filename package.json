{
  "name": "archivum",
  "version": "1.0.1",
  "description": "Organize your browser tabs by age. Automatically group tabs into age-based groups (Week+, Month+, Quarter+, etc.) and keep your workspace organized.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "cross-env CHROME_PATH=$HOME/.cache/ms-playwright/chromium-1223/chrome-linux64/chrome DEV_FEATURES=true wxt -b chromium --mv3",
    "dev:firefox": "cross-env DEV_FEATURES=true wxt -b firefox --mv3",
    "dev:edge": "cross-env DEV_FEATURES=true wxt -b edge --mv3",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "test:playwright:chromium": "npx playwright test -c playwright.config.ts --project chrome-mv3",
    "test": "npm run test:unit && npm run test:playwright:chromium",
    "build": "npm run type-check && wxt build -b chrome --mv3 && wxt build -b firefox --mv3 && wxt build -b edge --mv3",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "release": "npm run type-check && wxt zip -b chrome --mv3 && wxt zip -b firefox --mv3 && wxt zip -b edge --mv3",
    "ci": "npm run type-check && npm run test:unit && npm run test:playwright:chromium && npm run release"
  },
  "dependencies": {
    "@quasar/extras": "1.17.0",
    "@vueuse/core": "^13.5.0",
    "@webext-core/proxy-service": "^2.0.1",
    "dayjs": "^1.11.20",
    "pinia": "^3.0.4",
    "quasar": "^2.19.3",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@quasar/vite-plugin": "^1.11.0",
    "@tsconfig/node24": "^24.0.0",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.8.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.2.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "happy-dom": "^20.10.2",
    "playwright": "^1.57.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vite-plugin-web-extension": "4.5.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.2.9",
    "web-ext": "^10.1.0",
    "wxt": "^0.20.26"
  }
}
